{
  "name": "ExchangeSafetyReport",
  "type": "object",
  "properties": {
    "reporter_user_id": {
      "type": "string"
    },
    "reporter_email": {
      "type": "string",
      "format": "email"
    },
    "reported_user_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "harassment",
        "misrepresentation",
        "credential_concern",
        "conflict_of_interest",
        "privacy_concern",
        "fraud_concern",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewing",
        "action_taken",
        "dismissed",
        "resolved"
      ],
      "default": "submitted"
    },
    "admin_notes": {
      "type": "string",
      "maxLength": 5000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "reporter_user_id",
    "reporter_email",
    "reported_user_id",
    "reason",
    "description",
    "status",
    "created_at"
  ],
  "rls": {
    "create": {
      "data.reporter_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.reporter_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}