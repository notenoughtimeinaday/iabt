{
  "name": "UsageLedger",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "plan_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "estimate",
        "reserve",
        "capture",
        "release",
        "refund",
        "included_usage"
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "generation",
        "media_credit",
        "usd_cent"
      ]
    },
    "amount": {
      "type": "integer"
    },
    "pricing_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "preview",
        "pending",
        "settled",
        "reversed"
      ],
      "default": "preview"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "event_type",
    "unit",
    "amount",
    "pricing_version",
    "description",
    "status",
    "occurred_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}