{
  "name": "CredentialClaim",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "credential_type": {
      "type": "string",
      "maxLength": 160
    },
    "jurisdiction": {
      "type": "string",
      "maxLength": 120
    },
    "issuing_authority": {
      "type": "string",
      "maxLength": 200
    },
    "claim_summary": {
      "type": "string",
      "maxLength": 2000
    },
    "reference_url": {
      "type": "string",
      "maxLength": 500
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected",
        "expired"
      ],
      "default": "unverified"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "none",
        "document_review",
        "official_registry",
        "organization_confirmation",
        "manual_review"
      ],
      "default": "none"
    },
    "reviewed_by": {
      "type": "string",
      "maxLength": 160
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "credential_type",
    "jurisdiction",
    "issuing_authority",
    "claim_summary",
    "verification_status",
    "verification_method",
    "submitted_at"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}