{
  "name": "CreationArtifact",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "plan_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 180
    },
    "kind": {
      "type": "string",
      "enum": [
        "app",
        "document",
        "image",
        "video",
        "audio",
        "code",
        "gcode",
        "archive",
        "data",
        "other"
      ],
      "default": "other"
    },
    "mime_type": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "provider": {
      "type": "string"
    },
    "ephemeral": {
      "type": "boolean",
      "default": false
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "plan_id",
    "job_id",
    "name",
    "kind",
    "mime_type",
    "provider"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}