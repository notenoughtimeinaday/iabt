{
  "name": "AccountEntitlement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user ID receiving this entitlement"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "builder",
        "pro"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "canceled",
        "inactive"
      ],
      "default": "active"
    },
    "billing_provider": {
      "type": "string",
      "enum": [
        "none",
        "stripe",
        "google_play"
      ],
      "default": "none"
    },
    "provider_customer_id": {
      "type": "string"
    },
    "provider_subscription_id": {
      "type": "string"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "ai_hourly_limit": {
      "type": "integer",
      "minimum": 1,
      "default": 5
    },
    "project_limit": {
      "type": "integer",
      "minimum": 0,
      "default": 3,
      "description": "0 means unlimited"
    },
    "react_export_enabled": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "plan",
    "status",
    "billing_provider",
    "ai_hourly_limit"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}