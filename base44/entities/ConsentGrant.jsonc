{
  "name": "ConsentGrant",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "plan_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "prepare",
        "render"
      ]
    },
    "pricing_version": {
      "type": "string"
    },
    "accepted_total_cents": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD"
      ],
      "default": "USD"
    },
    "acceptance_text": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "plan_id",
    "mode",
    "pricing_version",
    "accepted_total_cents",
    "currency",
    "acceptance_text",
    "accepted_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}