{
  "name": "Asset",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owning Base44 user ID for service-created assets"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "file_type": {
      "type": "string",
      "title": "File Type"
    },
    "mime_type": {
      "type": "string",
      "title": "MIME Type"
    },
    "size_bytes": {
      "type": "number",
      "title": "Size (bytes)"
    },
    "kind": {
      "type": "string",
      "title": "Kind",
      "enum": [
        "document",
        "image",
        "audio",
        "video",
        "archive",
        "code",
        "data",
        "other"
      ],
      "default": "other"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name",
    "project_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}