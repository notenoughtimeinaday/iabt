{
  "name": "AiUsage",
  "type": "object",
  "properties": {
    "window_key": {
      "type": "string",
      "description": "Per-user UTC usage bucket, prefixed with hour: or month:"
    },
    "request_count": {
      "type": "integer",
      "default": 0
    },
    "last_request_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "window_key",
    "request_count"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}