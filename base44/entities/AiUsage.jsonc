{
  "name": "AiUsage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user ID for server-owned quota accounting"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "usage_kind": {
      "type": "string",
      "enum": [
        "planning",
        "app_generation",
        "image_generation",
        "content_generation",
        "media_preproduction"
      ],
      "default": "app_generation"
    },
    "window_key": {
      "type": "string",
      "description": "Per-user UTC usage bucket, prefixed with hour: or month:"
    },
    "request_count": {
      "type": "integer",
      "default": 0
    },
    "last_request_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "window_key",
    "request_count"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}