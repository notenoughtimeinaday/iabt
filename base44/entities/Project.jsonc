{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Project name",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "enum": [
        "SaaS",
        "Commerce",
        "Operations",
        "Finance",
        "Healthcare",
        "Education",
        "Other"
      ],
      "default": "SaaS"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "ready",
        "archived"
      ],
      "default": "draft"
    },
    "color": {
      "type": "string",
      "default": "#7c3aed"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "app_definition": {
      "type": "object",
      "description": "Canonical IABT AppDefinition"
    },
    "last_opened_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "app_definition"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}