# Frontend runtime selector
VITE_IABT_BACKEND=standalone
VITE_IABT_API_URL=https://api.insuredspending.org

# Standalone server
IABT_DATABASE_URL=
IABT_AUTH_SECRET=
IABT_PUBLIC_ORIGIN=https://insuredspending.org
IABT_API_ORIGIN=https://api.insuredspending.org
IABT_JOB_WORKER_ENABLED=true
IABT_JOB_POLL_MS=1500
IABT_JOB_LEASE_MS=300000
IABT_MAX_UPLOAD_BYTES=26214400

# S3-compatible private object storage is mandatory in production.
IABT_STORAGE_PROVIDER=s3
IABT_STORAGE_ENDPOINT=
IABT_STORAGE_REGION=us-east-1
IABT_STORAGE_BUCKET=
IABT_STORAGE_ACCESS_KEY_ID=
IABT_STORAGE_SECRET_ACCESS_KEY=

# Direct provider integrations
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
LUMA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUILDER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_AI_CREDIT_PACK_PRICE_ID=

# Production gates remain fail-closed until explicitly approved.
IABT_STRIPE_MODE=test
IABT_ENABLE_PAID_AI=false
IABT_ENABLE_PAID_AUDIO=false
IABT_AUDIO_BILLING_READY=false
IABT_ELEVENLABS_COST_PER_MINUTE_CENTS=
IABT_ELEVENLABS_COMMERCIAL_APPROVED=false
IABT_ENABLE_PAID_MEDIA=false
IABT_MEDIA_BILLING_READY=false
IABT_LUMA_COMMERCIAL_APPROVED=false
