# Copy to .env.staging and keep the real file out of source control.
NODE_ENV=production
IABT_PUBLIC_ORIGIN=https://staging.insuredspending.org
IABT_API_ORIGIN=https://api-staging.insuredspending.org
IABT_DATABASE_PASSWORD=replace-with-a-long-random-password
IABT_AUTH_SECRET=replace-with-at-least-32-random-bytes
IABT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
IABT_EMAIL_FROM=IABT <noreply@insuredspending.org>
IABT_EMAIL_REPLY_TO=support@insuredspending.org
IABT_STORAGE_PROVIDER=s3
IABT_STORAGE_ENDPOINT=https://your-s3-compatible-endpoint.example
IABT_STORAGE_REGION=us-east-1
IABT_STORAGE_BUCKET=iabt-staging-private
IABT_STORAGE_ACCESS_KEY_ID=
IABT_STORAGE_SECRET_ACCESS_KEY=
IABT_JOB_POLL_MS=1500
IABT_JOB_LEASE_MS=300000
IABT_EXPOSE_DEV_OTP=false

# Provider credentials remain server-side. Keep paid gates false for the first staging boot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
IABT_ENABLE_PAID_AI=false
# Estimated budgets are not provider-enforced dollar hard caps.
IABT_ENABLE_ORCHESTRATION=false
IABT_ORCHESTRATION_BUDGET_ACCEPTED=false
IABT_OPENAI_RESPONSE_COST_CENTS=0
IABT_ORCHESTRATION_BUDGET_CENTS=0
IABT_ORCHESTRATION_MAX_TURNS=8
IABT_ORCHESTRATION_MAX_POLLS=120
IABT_ORCHESTRATION_MAX_OUTPUT_TOKENS=6000
IABT_ENABLE_PAID_IMAGES=false
IABT_OPENAI_IMAGE_COMMERCIAL_APPROVED=false
IABT_OPENAI_IMAGE_COST_CENTS=

ELEVENLABS_API_KEY=
IABT_ENABLE_PAID_AUDIO=false
IABT_AUDIO_BILLING_READY=false
IABT_ELEVENLABS_COMMERCIAL_APPROVED=false
IABT_ELEVENLABS_COST_PER_MINUTE_CENTS=

LUMA_API_KEY=
IABT_ENABLE_PAID_MEDIA=false
IABT_MEDIA_BILLING_READY=false
IABT_LUMA_COMMERCIAL_APPROVED=false
IABT_LUMA_COST_PER_5_SECONDS_CENTS=

IABT_STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUILDER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_AI_CREDIT_PACK_PRICE_ID=
